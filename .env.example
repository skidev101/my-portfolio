# Copy to .env.local and fill in. Required for the contact form.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered
CONTACT_TO_EMAIL=skidev101@gmail.com

# Verified sender. Must be an address on a domain verified in Resend —
# the default sandbox address only delivers to your own account email.
CONTACT_FROM_EMAIL="Portfolio Contact <hello@yourdomain.com>"
